# Chege Agent Configuration (.env.example)

# Network & Server (Standard ASGI port 8000)
CHEGE_HOST=127.0.0.1
CHEGE_PORT=8000

# Base Directories
CHEGE_DATA_DIR=./data
CHEGE_WORKDIR=./workdir
CHEGE_LOGS_DIR=./logs

# Database
# Leave empty for embedded SQLite at ${CHEGE_DATA_DIR}/chege.db (default).
# The deploy script fills this in when started with --with-postgres.
CHEGE_DATABASE_URL=

# Deployment selectors (managed by scripts/deploy.sh; do not edit by hand unless needed)
DEPLOY_POSTGRES=false
DEPLOY_LLAMACPP=false
DEPLOY_OLLAMA=false

# Optional Postgres container (only used with --with-postgres).
# It is internal-only: no host port is published. Change the password.
POSTGRES_DB=chege
POSTGRES_USER=chege
POSTGRES_PASSWORD=change-me-generate-a-random-one

# Local-only service: no login/auth by design.
# Keep CHEGE_HOST=127.0.0.1 and do not expose the port publicly.

# Sandboxing ('docker' or 'local')
CHEGE_SANDBOX_BACKEND=docker
CHEGE_DOCKER_SOCKET_PROXY=tcp://docker-socket-proxy:2375
CHEGE_DEFAULT_SANDBOX_IMAGE=chege-agent-sandbox-polyglot:latest
CHEGE_SANDBOX_CONTAINER_PREFIX=chege-agent-sandbox

# LLM Providers ('llama_cpp', 'ollama', or 'openai')
# Default & Recommended: llama.cpp server (:8080/v1)
CHEGE_DEFAULT_PROVIDER=llama_cpp
CHEGE_LLAMACPP_URL=http://host.docker.internal:8080/v1
CHEGE_OLLAMA_URL=http://host.docker.internal:11434

# llama.cpp provider (scripts/llamacpp.sh) — official PRECOMPILED binaries, no build.
# CHEGE_LLAMACPP_MODEL: absolute path to a local .gguf. Empty => download Qwen2.5-1.5B.
# Host must be 0.0.0.0 so the Docker container can reach it via host.docker.internal.
CHEGE_LLAMACPP_MODEL=
CHEGE_LLAMACPP_VERSION=b12359
CHEGE_LLAMACPP_HOST=0.0.0.0
CHEGE_LLAMACPP_PORT=8080
# Must be >= CHEGE_DEFAULT_CONTEXT_WINDOW. Restart with:
#   bash scripts/llamacpp.sh restart
CHEGE_LLAMACPP_CTX=8192
CHEGE_LLAMACPP_NGL=0

# Host-side model control service (scripts/modelctl.py) used by /models.
# Binds 127.0.0.1 + docker0 only; the container reaches it via host-gateway.
CHEGE_LLAMACPP_CONTROL_URL=http://host.docker.internal:8081
CHEGE_MODELCTL_PORT=8081

# Cloud providers (optional). Tokens can also be saved per provider in Settings.
# Each provider defaults to its vendor endpoint; override the URL only for a gateway.
# CHEGE_OPENAI_BASE_URL=https://api.openai.com/v1
# CHEGE_OPENAI_API_KEY=sk-...
# CHEGE_DEEPSEEK_API_KEY=sk-...
# CHEGE_GEMINI_API_KEY=...
# CHEGE_GROK_API_KEY=xai-...
# CHEGE_ANTHROPIC_API_KEY=sk-ant-...
# CHEGE_MISTRAL_API_KEY=...
# CHEGE_GROQ_API_KEY=gsk_...
# CHEGE_OPENROUTER_API_KEY=sk-or-...
# CHEGE_TOGETHER_API_KEY=...
# CHEGE_PERPLEXITY_API_KEY=pplx-...

# Agent Engine Defaults
# Keep this <= CHEGE_LLAMACPP_CTX so prompts fit the server's context size.
CHEGE_DEFAULT_CONTEXT_WINDOW=8192
CHEGE_DEFAULT_TEMPERATURE=0.2
CHEGE_DEFAULT_TOP_P=0.9
CHEGE_MAX_STEPS=50
CHEGE_RUN_TIMEOUT_SECONDS=600
CHEGE_PROVIDER_TIMEOUT_SECONDS=120

# Runner-specific options
CHEGE_OLLAMA_NUM_CTX=8192
CHEGE_OLLAMA_KEEP_ALIVE=15m
# CHEGE_OPENAI_MAX_TOKENS=2048  # blank => provider default
