# Chege Agent Configuration (.env.example)

# Network & Server
CHEGE_HOST=127.0.0.1
CHEGE_PORT=9100

# Base Directories
CHEGE_DATA_DIR=./data
CHEGE_WORKDIR=./workdir
CHEGE_LOGS_DIR=./logs

# Security & Authentication
CHEGE_AUTH_ENABLED=false
# CHEGE_AUTH_TOKEN=your-random-secret-token-here

# Sandboxing ('docker' or 'local')
CHEGE_SANDBOX_BACKEND=docker
CHEGE_DOCKER_SOCKET_PROXY=tcp://docker-socket-proxy:2375
CHEGE_DEFAULT_SANDBOX_IMAGE=chege-sandbox-polyglot:latest

# LLM Providers ('ollama' or 'openai')
CHEGE_DEFAULT_PROVIDER=ollama
CHEGE_OLLAMA_URL=http://host.docker.internal:11434

# OpenAI Configuration (optional if using OpenAI)
# CHEGE_OPENAI_BASE_URL=https://api.openai.com/v1
# CHEGE_OPENAI_API_KEY=sk-...

# Agent Engine Defaults
CHEGE_DEFAULT_CONTEXT_WINDOW=16384
CHEGE_MAX_STEPS=50
CHEGE_RUN_TIMEOUT_SECONDS=600
